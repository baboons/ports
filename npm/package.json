    "local-domains",
    "dev-server",
    "cli"
  ],
  "license": "MIT",
  "author": "Johan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baboons/ports.git"
  },
  "homepage": "https://github.com/baboons/ports#readme",
  "bugs": {
    "url": "https://github.com/baboons/ports/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
